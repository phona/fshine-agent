  "operations": [
    {
      "name": "dummy.query",
      "domain": "dummy",
      "command": "query",
      "access": "read",
      "script": "src/dummy/scripts/query.js",
      "executor": "dummy-script",
      "est_seconds": 10,
      "weight": 2,
      "args": {
        "positional": [],
        "flags": [
          {
            "flag": "--collection",
            "required": true,
            "style": "name",
            "desc": "collection name or keyword (exact match preferred, substring match may be ambiguous)"
          },
          {
            "flag": "--window",
            "required": false,
            "style": "code",
            "desc": "window code, e.g. W1; must exist for the collection"
          }
        ]
      },
      "serve": {
        "query": true,
        "prepare": true,
        "commit": true
      },
      "protocol": null
    },
    {
      "name": "dummy.scratch",
