{
  "schemaVersion": 1,
  "platform": "dummy-platform",
  "scenario": "dummy-finance",
  "accessSemantics": {
    "read": {
      "plan": true,
      "confirm": false,
      "mock": true
    },
    "scratch": {
      "plan": false,
      "confirm": false,
      "mock": false
    },
    "write": {
      "plan": true,
      "confirm": true,
      "mock": true
    }
  },
  "labels": {
    "dummy.query": "query records",
    "dummy.scratch": "local computation",
    "dummy.prepare": "prepare records",
    "dummy.commit": "commit records",
    "dummy.proposal": "create proposal",
    "dummy.proposal-commit": "commit proposal",
    "ballot.query": "query ballots",
    "ballot.scratch": "ballot scratch",
    "ballot.prepare": "prepare ballots",
    "ballot.commit": "commit ballots",
    "ballot.proposal": "create ballot proposal",
    "ballot.proposal-commit": "commit ballot proposal"
  },
  "errorCatalog": {
    "QUERY_REQUIRED": "Provide --collection <name>.",
    "COLLECTION_NOT_FOUND": "No collection matches that keyword. Check the exact collection name and retry.",
    "COLLECTION_AMBIGUOUS": "More than one collection matches. Confirm the exact collection name and retry.",
    "WINDOW_NO_DATA": "That window has no data for this collection. Retry with a window from availableWindows.",
    "COLLECTION_LOCKED": "That collection is locked. It cannot accept writes in its current state.",
    "PLAN_UNKNOWN_FIELD": "Plan draft has an undeclared top-level field. Remove it and resubmit.",
    "PLAN_CALLS_REQUIRED": "Plan draft must contain a non-empty calls array.",
    "PLAN_UNKNOWN_OPERATION": "Plan call names an unregistered operation.",
    "PLAN_OPERATION_NOT_READ_ONLY": "Plan calls may only name read-only operations (dummy.query, dummy.scratch).",
    "PROPOSAL_UNKNOWN_FIELD": "Proposal payload has an undeclared top-level field. Remove it and resubmit.",
    "PROPOSAL_NOT_PENDING": "Proposal is no longer pending. Do not commit it again.",
    "PROPOSAL_EXPIRED": "Proposal has expired. Create a new proposal.",
    "PROPOSAL_TOKEN_UNTRUSTED": "Proposal commit token is missing, malformed, expired or does not match this proposal.",
    "PROPOSAL_STATE_CORRUPT": "Proposal state is corrupt. Fail closed; do not guess.",
    "PLAN_ACTIVATION_UNTRUSTED": "Plan activation token is missing, malformed, expired or does not match this plan.",
    "PLAN_NOT_FOUND": "No such plan.",
    "PLAN_NOT_PENDING": "Plan is not pending activation.",
    "COLLECTION_FAULT": "That collection cannot be read in its current state. Report the failure as-is.",
    "INVALID_ARGUMENT": "Provide a string value for the named argument."
  },
  "reads": {
    "dummy.query": {
      "args": [
        {
          "name": "--collection",
          "type": "string"
        },
        {
          "name": "--topic",
          "type": "string"
        },
        {
          "name": "--window",
          "type": "string"
        },
        {
          "name": "--round",
          "type": "string"
        }
      ],
      "requirements": [
        {
          "anyOf": [
            "--collection",
            "--topic"
          ],
          "error": {
            "code": "QUERY_REQUIRED",
            "message": "Missing --collection or --topic"
          }
        }
      ],
      "source": {
        "keys": [
          "--collection",
          "--topic"
        ],
        "mode": "exact-or-unique-substring"
      },
      "window": {
        "keys": [
          "--window",
          "--round"
        ]
      },
      "invalidArg": {
        "code": "INVALID_ARGUMENT",
        "message": "Argument {{arg.name}} must be a {{arg.type}}"
      },
      "responses": {
        "completed": {
          "status": "completed",
          "exitCode": 0,
          "data": {
            "collection": "{{source.collection}}",
            "window": "{{window.value}}",
            "items": "{{items}}",
            "count": "{{count}}"
          },
          "result": {
            "status": "completed",
            "collection": "{{source.collection}}",
            "items": "{{items}}",
            "count": "{{count}}",
            "fields": "{{fields}}"
          }
        },
        "ambiguous": {
          "status": "needs_input",
          "exitCode": 0,
          "data": {
            "query": "{{source.keyword}}",
            "candidates": "{{source.candidates}}"
          },
          "error": {
            "code": "COLLECTION_AMBIGUOUS",
            "message": "More than one collection matches \"{{source.keyword}}\""
          },
          "result": {
            "status": "needs_input",
            "collection": "{{source.keyword}}"
          }
        },
        "not_found": {
          "status": "not_found",
          "exitCode": 0,
          "data": {
            "query": "{{source.keyword}}",
            "candidates": "{{source.candidates}}"
          },
          "error": {
            "code": "COLLECTION_NOT_FOUND",
            "message": "No collection matches that keyword. Check the exact collection name and retry."
          },
          "result": {
            "status": "not_found",
            "collection": "{{source.keyword}}"
          }
        },
        "window_no_data": {
          "status": "not_found",
          "exitCode": 0,
          "data": {
            "query": "{{source.keyword}}",
            "window": "{{window.value}}",
            "availableWindows": "{{window.available}}"
          },
          "error": {
            "code": "WINDOW_NO_DATA",
            "message": "Window {{window.value}} has no data for collection {{source.collection}}"
          },
          "result": {
            "status": "not_found",
            "collection": "{{source.collection}}"
          }
        },
        "read_fault": {
          "status": "failed",
          "exitCode": 2,
          "data": null
        }
      }
    },
