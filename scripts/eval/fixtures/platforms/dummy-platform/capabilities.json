            "desc": "collection name (exact)"
          },
          {
            "flag": "--window",
            "required": false,
            "style": "code",
            "desc": "window code"
          },
          {
            "flag": "--count",
            "required": false,
            "style": "code",
            "desc": "record count to prepare"
          },
          {
            "flag": "--apply",
            "required": false,
            "style": "code",
            "desc": "write flag: present means this call WOULD write, prepare must refuse it"
          }
        ]
      },
      "serve": {
        "query": false,
        "prepare": true,
        "commit": false
      },
      "protocol": null
    },
