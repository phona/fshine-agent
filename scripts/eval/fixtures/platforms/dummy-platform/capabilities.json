      "est_seconds": 5,
      "weight": 1,
      "args": {
        "positional": [],
        "flags": [
          {
            "flag": "--input",
            "required": true,
            "style": "name",
            "desc": "input text file path (local computation only)"
          },
          {
            "flag": "--output",
            "required": false,
            "style": "name",
            "desc": "output file path; defaults to <input>.out"
          }
        ]
