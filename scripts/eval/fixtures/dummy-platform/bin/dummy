#!/bin/sh
# Generic mock execution layer entry point: delegates to the Node implementation.
# Kept as a shell shim because the fshine repo uses "type": "module", which makes
# an extensionless Node file load as ESM; the implementation is CommonJS.
#
# Test-only bridge (fshine eval infrastructure, NOT a consumption protocol): the
# real-model probe cannot pass argv through the host's fixed gateway spawn, so it
# exports FSHINE_EVAL_FIXTURE_STATE_DIR with the per-case root. Translate that to
# the fixture's --state-dir flag; direct harnesses pass the flag themselves.
if [ -n "${FSHINE_EVAL_FIXTURE_STATE_DIR:-}" ]; then
  exec node "$(dirname "$0")/dummy.cjs" --state-dir "$FSHINE_EVAL_FIXTURE_STATE_DIR" "$@"
fi
exec node "$(dirname "$0")/dummy.cjs" "$@"
