# ============================================================
# V0 部署秘密与本地参数。复制为 .env 后填写;.env 不进版本库。
# V0 渠道 = 企业微信智能机器人 · WebSocket 长连接(无需公网域名、无消息加解密)。
#
# 【.env 与 config/agent.yaml 的边界】
#   .env            = 秘密与连接凭据(企微凭据、LLM key/model)。绝不进版本库。
#   config/agent.yaml = 部署结构与授权(谁能用、连哪个数据源、授权数据范围)。
#   数据白名单只看 config/agent.yaml 里每用户的 accountSetIds。
#
# 【执行层治理变量】
#   执行层治理变量的权威名以该执行层声明为准。本文件只列通用接口的契约形状，
#   具体变量名与缺省值以接入的执行层声明为准。
# ============================================================

# ---- 智能机器人长连接凭据(管理台:智能机器人 → 你的机器人 → 长连接 API)----
# BotID
WECOM_BOT_ID=
# 长连接专用 Secret
WECOM_BOT_SECRET=
# 注意:机器人创建者需为企业超级管理员,收到的 from.userid 才是明文 userid
# (V0 按 wecom:<userid> 做授权映射;否则需额外的自建应用对接转明文,不在 V0 范围)

# ---- LLM(OpenAI 兼容接口;契约/单元测试不需要,真实对话需要)----
# Kimi 编程套餐:base = https://api.kimi.com/coding/v1,model = kimi-for-coding,key 前缀 sk-kimi-
# Kimi 开放平台(moonshot):base = https://api.moonshot.cn/v1,model = kimi-k2.5 等
# 换其他厂商只需改这三个值(如智谱:https://open.bigmodel.cn/api/paas/v4)。
LLM_API_BASE_URL=https://api.kimi.com/coding/v1
LLM_API_KEY=
LLM_MODEL=kimi-for-coding
# 思考深度(可选,off/minimal/low/medium/high/xhigh/max);是否生效取决于模型是否支持思考参数
LLM_THINKING_LEVEL=

# ---- 分层模型接缝(可选):Main Agent 单独配更快的模型,执行层 worker 仍走上面的 LLM_MODEL ----
# base/key 仍共用上面三个值,只分层模型 id 与思考深度。两个都不设 = Main 与 worker 同模型
# (与单模型部署行为完全一致)。
# LLM_MAIN_MODEL=              # 缺省回落 LLM_MODEL;置空/空白等同未配置
# LLM_MAIN_THINKING_LEVEL=     # Main 侧思考深度,缺省回落 LLM_THINKING_LEVEL(词表相同)


# ---- 执行层控制面（这些名字由**执行层平台**自己读取，fshine 不解析）----
# EXECUTION_EXECUTOR=mock：执行层网关把执行器替换为 mock 应答器——不开浏览器、不触网，
#   gate 矩阵/commit 令牌/审计照真。
# 忘设 = 意图走真实执行层，但光忘设还不够——还要过下面那道真平台执行门（EXECUTION_ALLOW_REAL=1）。
#   临时切真执行层：shell 里同时置空覆盖 + 显式授权
#   （EXECUTION_EXECUTOR= EXECUTION_ALLOW_REAL=1 npm run acceptance）；node --env-file 规则是真实
#   环境变量优先于文件。
# 2026-11-08 起 fshine **不再读** EXECUTION_EXECUTOR：编排层不判"这个部署允不允许写"，
#   落账的授权/拒绝/warning 由执行层自己的门给出，宿主只如实转述（原宿主侧
#   FSHINE_REAL_COMMIT 写授权闸已连 platform-mock.ts 判据源一起退役，见 debt-ledger 的
#   D-075/D-197 重登记节）。
# EXECUTION_MOCK_STATE：mock 状态 JSON 路径（显式声明时宿主脚本才会重置它；未声明则由执行层
#   平台用自己的缺省状态文件，编排层不兜底路径）。
#   重置 mock 数据 = 删掉该状态文件，下次调用自动从 seed 重新播种。
# EXECUTION_ALLOW_REAL=1：真执行层执行门（fail-closed；判据住在平台网关的 spawn 决策处，fshine 只把
#   process.env 原样继承给平台子进程，不解析这个名字）。默认不设 = 拒绝：未授权却要 spawn
#   真执行器且触平台会话时，平台直接以 REAL_EXECUTION_NOT_ALLOWED 打回——与旧形态相反，
#   旧形态"忘设"就是真执行层（两次 env 没传到子进程树、真跑了浏览器的事故都出在那个 fail-open
#   上），现在"忘设"从"打到真执行层"变成"跑不起来"。只认字面量 '1'：'true'/'yes'/'0'/空值
#   一律不算授权——"模糊真值"正是 fail-open 的入口。门不触发的情形：EXECUTION_EXECUTOR=mock、
#   纯本地执行（不触平台会话的计算，与 local 模式同类风险）、local 模式。
EXECUTION_EXECUTOR=mock
EXECUTION_ALLOW_REAL=

# ---- 下游执行层保护（真实执行层才完全生效；mock 下同样串行，无害）----
# FSHINE_PLATFORM_CONCURRENCY：委派并发闸，默认 1（全局串行）。真实执行层是共享登录态
#   的持久浏览器 profile，并发委派会多开 Chrome 抢同一 profile——那是"被平台感知"的
#   典型方式。调大需先确认平台侧容忍度；排队只增加等待，不影响正确性。
# FSHINE_INBOUND_DEBOUNCE_MS：入站防抖窗口，默认 2000（0 = 关闭）。
#   企微模型里文件与文字是独立消息（MixedMsgItem 只支持 text/image，文件无法与文字同条），
#   所以"发 3 个文件 + 1 条指令"是 4 条消息。带正文的消息在进入会话队列前先等这么久，
#   让同一burst里稍晚到达的附件先落盘——否则指令那轮会漏掉最后到的文件（2026-10-08 实测：
#   4 条消息同一秒到达，顺序 文件→指令→文件，指令只带了 2 个，产出 3 人的不完整工资表，
#   全量 12 人）。附件-only 消息不等待（发完立刻看到"已收到"）。
#   注意：这是延迟旋钮，会把基于时间的控制（平台冷却、限流窗口）整体后移；生产上冷却
#   10 分钟、防抖 2 秒可忽略，但夹具/测试若用秒级冷却需把它设 0。
# FSHINE_PLATFORM_COOLDOWN_MS：平台健康冷却时长，默认 600000（10 分钟）。同一会话连续
#   2 次平台登录/环境类失败（AUTH_* / NEEDS_LOGIN，码级判据）后进入冷却：冷却期内新回合
#   不再发起平台调用，直接回复"平台侧异常、已暂停自动重试、约 N 分钟后恢复"；冷却后的
#   下一回合允许一次探测性调用，成功即清零、失败再进一轮冷却。平台持续异常时可调大，
#   避免用户每轮都等一次注定失败的查询；不需要治标补法时也不需要关（阈值 2 次不变）。
# EXECUTION_RATE_LIMIT：平台网关限流（不设则用执行层默认值）。显式声明可防止测试环境放宽的
#   值被带进生产；'off' 整体旁路仅限排障。
# FSHINE_ATTACHMENT_DIR：企微附件落盘位置，缺省 <平台根>/tmp/attachments（平台根未显式指定时
#   即 <cwd>/tmp/attachments）。渠道层把用户发来的文件（Excel 等）下载解密后写到这里，只把
#   **绝对路径**交给编排层——宿主与 worker 跨进程，Buffer 进不了 worker 的决策上下文。
#   用户提交的文件内容会接触这个位置，因此：① 留在平台根的 tmp/ 草稿区（默认即如此，
#   网关脚本按 cwd 就能打开它），不要和 .browser-profile / auth 这些平台凭据放在一起；
#        ② 按部署的磁盘与备份策略调（生产上用户文件会持续累积，需配清理）。
FSHINE_PLATFORM_CONCURRENCY=1
# 平台等待队列容量（不含正在执行者），默认 100；排队可取消，不增加平台并发。
FSHINE_PLATFORM_QUEUE_CAPACITY=100
# inline：同步委派（默认）；background：后台 Worker，Planner 可继续接待下一问。
# 后台任务完成后主动交付文字和文件；可查询/取消，不支持运行中 steer 或暂停恢复。
# 切回 inline 后须先让已有后台任务完成或取消并排干，才能回退代码。
FSHINE_WORKER_DISPATCH_MODE=inline
# 停机排干上限（毫秒），默认 30000：收到 SIGINT/SIGTERM 后等待在飞后台任务与终态事件
# 投递落定的最长时间。缺省/非法值回退默认；0 = 不等待。排干到期仍未落定的投递不在
# 停机期强收，由下次启动的未投递清扫（sweepUndeliveredTaskRuns）兜底重投或标失败。
# FSHINE_SHUTDOWN_DRAIN_MS=30000
FSHINE_PLATFORM_COOLDOWN_MS=600000
# 模板不钉示范值：不设 = 执行层默认桶（environment-variables.md「执行层治理」节有同义记载），
#   按部署实际限流能力调整；要显式限流时按该节的 JSON 形状自定——read/prepare/write/global/
#   api 五桶各带 burst 与 perMs，数值按部署自定，勿照抄别处的数字。
