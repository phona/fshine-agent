# ============================================================
# V0 部署秘密与本地参数。复制为 .env 后填写;.env 不进版本库。
# V0 渠道 = 企业微信智能机器人 · WebSocket 长连接(无需公网域名、无消息加解密)。
#
# 【.env 与 config/agent.yaml 的边界】
#   .env            = 秘密与连接凭据(企微凭证、LLM key/model)。绝不进版本库。
#   config/agent.yaml = 部署结构与授权(谁能用、连哪个数据源、授权账套)。
#   账套白名单只看两处:每用户 accountSetIds(在 yaml)+ 17dz 服务端
#   ALLOWED_ACCOUNT_SETS(17dz-platform 的部署 env,本文件不再设)。
# ============================================================

# ---- 智能机器人长连接凭证(管理台:智能机器人 → 你的机器人 → 长连接 API)----
# BotID
WECOM_BOT_ID=
# 长连接专用 Secret
WECOM_BOT_SECRET=
# 注意:机器人创建者需为企业超级管理员,收到的 from.userid 才是明文 userid
# (V0 按 wecom:<userid> 做授权映射;否则需额外的自建应用对接转明文,不在 V0 范围)

# ---- LLM(OpenAI 兼容接口;契约/单元测试不需要,真实对话需要)----
# Kimi 编程套餐:base = https://api.kimi.com/coding/v1,model = kimi-for-coding,key 前缀 sk-kimi-
# Kimi 开放平台(moonshot):base = https://api.moonshot.cn/v1,model = kimi-k2.5 等
# 换其他厂商只需改这三个值(如智谱:https://open.bigmodel.cn/api/paas/v4)。
LLM_API_BASE_URL=https://api.kimi.com/coding/v1
LLM_API_KEY=
LLM_MODEL=kimi-for-coding
# 思考深度(可选,off/minimal/low/medium/high/xhigh/max);是否生效取决于模型是否支持思考参数
LLM_THINKING_LEVEL=


# ---- 幻账平台 mock 控制面（联调用，详见 platform-mock.ts）----
# DZ_EXECUTOR=mock：平台网关把执行器替换为 mock 应答器——不开浏览器、不触网，
#   gate 矩阵/commit 令牌/审计照真；落账全链路在此模式下默认放开（写的是假状态）。
# 不设 = 真实平台。临时切真平台：shell 里置空覆盖（DZ_EXECUTOR= npm run acceptance），
#   node --env-file 规则是真实环境变量优先于文件。
# DZ_MOCK_STATE：mock 状态 JSON 路径（可省，服务端兜底 <平台根>/.runtime/mock-state.json）。
#   重置 mock 数据 = 删掉该状态文件，下次调用自动从 seed 重新播种。
# FSHINE_REAL_COMMIT=1：真平台落账放行（生产显式声明；缺省时确认码得到确定性拒绝，零写入）。
DZ_EXECUTOR=mock
FSHINE_REAL_COMMIT=
