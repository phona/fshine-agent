{
  "name": "fshine-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WeCom orchestrator: delegates declared platform work to a cwd-bound subagent",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env --import tsx apps/server/main.ts",
    "ask": "node --env-file-if-exists=.env --import tsx scripts/ask.ts",
    "tasks": "node --env-file-if-exists=.env --import tsx scripts/tasks.ts",
    "ops": "node --env-file-if-exists=.env --import tsx scripts/ops.ts",
    "alerts": "node --env-file-if-exists=.env --import tsx scripts/ops/alerts.ts",
    "usage": "node --env-file-if-exists=.env --import tsx scripts/ops/usage-report.ts",
    "cleanup:runs": "node --env-file-if-exists=.env --import tsx scripts/cleanup-runs.ts",
    "eval:user": "node --env-file-if-exists=.env --import tsx scripts/eval/convergence-r1/runner.ts",
    "eval:write-loop": "node --env-file-if-exists=.env --import tsx scripts/eval/real/write-loop.ts",
    "eval:write-loop-scenarios": "node --env-file-if-exists=.env --import tsx scripts/eval/real/write-loop-scenarios.ts",
    "eval:cap01": "node --import tsx scripts/eval/cap01/run-all.ts",
    "eval:bizprobe": "node --env-file-if-exists=.env --import tsx scripts/eval/business-e2e/run.ts",
    "eval:bizbatch2": "node --env-file-if-exists=.env --import tsx scripts/eval/business-e2e/experiments/run.ts",
    "eval:bizbatch3": "node --env-file-if-exists=.env --import tsx scripts/eval/business-e2e/experiments/run.ts",
    "ci": "sh scripts/ci.sh",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "better-sqlite3": "^12.0.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "yaml": "^2.4.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
