{
  "name": "fshine-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tax Agent V0: WeCom employees querying permitted accounting data via 17dz read MCP",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "start": "node --env-file=.env --import tsx apps/server/main.ts",
    "smoke:wecom": "node --env-file=.env --import tsx scripts/smoke-wecom.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.0.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.0",
    "yaml": "^2.4.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
