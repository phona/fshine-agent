{
  "name": "fshine-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WeCom orchestrator: delegates declared platform work to a cwd-bound subagent",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:minimal": "node --env-file-if-exists=.env --import tsx scripts/demo-minimal.ts",
    "eval:generic-mock": "node --import tsx scripts/eval/generic-mock.ts",
    "ci": "sh scripts/ci.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "better-sqlite3": "^12.0.0",
    "express": "^4.21.2",
    "yaml": "^2.4.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
